# Copy to .env and adjust. Both the API server and the Vite dev server read this file.

# Folders scanned for PDFs on first start (only used while no folder is configured yet;
# afterwards manage folders in the app under Settings). Separate several with ":".
STUDYSPACE_LIBRARY_DIRS=/home/you/University/Semester
# Comma-separated folder names or relative paths to skip when seeding.
STUDYSPACE_EXCLUDES=

# Where the SQLite database and edit backups live (default: ~/.local/share/studyspace).
# STUDYSPACE_DATA_DIR=/home/you/.local/share/studyspace

# API server address (the web UI proxies /api to it).
# STUDYSPACE_HOST=127.0.0.1
# STUDYSPACE_PORT=4317

# Undoable file edits kept per PDF (page edits / Save to PDF). Each keeps the previous file
# version under <data dir>/history. 0 disables undo for file edits.
# STUDYSPACE_HISTORY_LIMIT=10

# OCR (optional, runs only when you use the OCR tools). Install once with:
#   sudo apt install ocrmypdf tesseract-ocr
# Languages: install e.g. tesseract-ocr-ben and set STUDYSPACE_OCR_LANG=eng+ben.
# STUDYSPACE_OCR_LANG=eng
# STUDYSPACE_OCRMYPDF=ocrmypdf
# STUDYSPACE_TESSERACT=tesseract

# Optional AI provider. "none" keeps StudySpace fully offline. See README → "Adding an AI provider".
AI_PROVIDER=none
# AI_API_KEY=
# AI_MODEL=
# AI_BASE_URL=
